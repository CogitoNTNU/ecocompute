AZURE_OPENAI_BASE_URL=https://ecollm.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
# Add one entry per deployment in the same Foundry resource. Optional USD rates
# per million tokens: add input_usd_per_million and output_usd_per_million to
# each entry after checking your current Azure price sheet and deployment type.
AZURE_OPENAI_MODELS_JSON=[{"id":"gpt-4.1-nano","label":"GPT-4.1 Nano","deployment":"gpt-4.1-nano"},{"id":"gpt-6-luna","label":"GPT-6 Luna","deployment":"gpt-6-luna"}]

# Local-only default: the UI talks to the local always-on API.
BACKEND_MODE=always-on
BACKEND_URLS_JSON={}
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional locally. Set NTNU's tenant ID and your project's multitenant app client ID.
# The app must include the `acct` claim in access tokens; group restriction is optional.
# In Azure, Terraform requires tenant and client IDs to protect chat and billing APIs.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ALLOWED_GROUP_ID=

# Optional billing. Use `az login` locally; Terraform enables managed identities in Azure.
AZURE_COST_SUBSCRIPTION_ID=7ec1bafb-324b-43b8-9c30-76e35b9d38cd
AZURE_COST_RESOURCES_JSON={"autoscale":["/subscriptions/7ec1bafb-324b-43b8-9c30-76e35b9d38cd/resourceGroups/ecocompute-rg-8gy5aj/providers/Microsoft.App/containerApps/ecocompute-autoscale"],"always-on":["/subscriptions/7ec1bafb-324b-43b8-9c30-76e35b9d38cd/resourceGroups/ecocompute-rg-8gy5aj/providers/Microsoft.App/containerApps/ecocompute-always-on"],"foundry":["/subscriptions/7ec1bafb-324b-43b8-9c30-76e35b9d38cd/resourceGroups/llm-rg/providers/Microsoft.CognitiveServices/accounts/ecollm"],"shared":["/subscriptions/7ec1bafb-324b-43b8-9c30-76e35b9d38cd/resourceGroups/ecocompute-rg-8gy5aj/providers/Microsoft.ContainerRegistry/registries/ecocompute8gy5aj","/subscriptions/7ec1bafb-324b-43b8-9c30-76e35b9d38cd/resourceGroups/ecocompute-rg-8gy5aj/providers/Microsoft.App/managedEnvironments/ecocompute"]}
# Subscription: 7ec1bafb-324b-43b8-9c30-76e35b9d38cd
# Copy the JSON from: terraform -chdir=infra/terraform/azure output -json cost_resource_ids
